<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Marten" Version="8.38.2" />
        <PackageReference Include="MediatR" Version="12.5.0" />
        <!-- Previously arrived transitively through Core.BPM; BPM.Core no longer depends on it.
             Resolved from the credobank Azure Artifacts feed (see nuget.config in the Azure repo). -->
        <PackageReference Include="Credo.Core.Shared" Version="1.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.23"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0"/>
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <Content Remove="Features\NewLoan\**" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BPM.Core\BPM.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Features\NewLoan\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Features\NewLoan\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Features\NewLoan\**" />
    </ItemGroup>

</Project>
